# ── GitHub Secrets ──────────────────────────────────────────────────────────
# Add each of these at:
# https://github.com/mmiclette/content-automation/settings/secrets/actions

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot Token (xoxb-...) — from your Slack App's OAuth page
SLACK_BOT_TOKEN=xoxb-...

# Slack Signing Secret — from your Slack App's Basic Information page
SLACK_SIGNING_SECRET=...

# Slack channel ID for #content-automation (C... format, not the channel name)
# Right-click #content-automation in Slack → Copy channel ID
SLACK_CHANNEL_ID=C...

# Google session for NotebookLM — generated by scripts/export_session.py
# This is a base64-encoded JSON string. Regenerate if you get auth errors.
NOTEBOOKLM_SESSION=eyJ...

# Google account email used for NotebookLM
NOTEBOOKLM_EMAIL=matthew@neuroflow.com

# GitHub Personal Access Token with repo + workflow scopes
# Create at: https://github.com/settings/tokens
GH_PAT=ghp_...

# GitHub repository in owner/repo format
GH_REPO=mmiclette/content-automation

# ── Webhook Relay Secrets ────────────────────────────────────────────────────
# Set these as environment variables on your Render / Railway relay service
# AND as GitHub Secrets so the workflow can call the relay

# Public URL of your deployed webhook relay
RELAY_URL=https://your-relay-name.onrender.com

# Random secret string — used to authenticate calls from GitHub Actions to relay
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RELAY_SECRET=...
